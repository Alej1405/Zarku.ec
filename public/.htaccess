# Zarku — configuración Apache para hosting estático (cPanel)

# Forzar HTTPS (descomenta cuando el certificado SSL esté activo)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# SPA fallback + OG dinámico de noticias
<IfModule mod_rewrite.c>
  RewriteEngine On
  # 1) Archivos/carpetas reales (assets, imágenes, og.php...) se sirven tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # 2) Landing de una noticia -> og.php inyecta el Open Graph de esa nota.
  #    (La lista /noticias no lleva slug y sigue de largo a la SPA.)
  RewriteRule ^noticias/([A-Za-z0-9-]+)/?$ og.php?slug=$1 [L,QSA]
  # 3) Cualquier otra ruta -> index.html (routing del lado del cliente).
  RewriteRule ^ index.html [L]
</IfModule>

# Cache
<IfModule mod_headers.c>
  # Assets con hash de Vite → inmutables un año
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imágenes de marca (rutas estables) → 7 días
  <FilesMatch "\.(png|jpg|jpeg|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML → siempre revalidar
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/wasm
</IfModule>

# Tipos MIME (por si el servidor no los reconoce)
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType font/woff2 .woff2
</IfModule>
